# Application
APP_NAME=api-stations-and-radio-link
APP_VERSION=1.0.0
APP_ENV=development

# HTTP server
HTTP_ADDR=:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s
SWAGGER_HOST=localhost:8080

# Database
# Currently the application opens MySQL through GORM.
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=admin
DB_NAME=api_stations_radio_link
# DB_DSN overrides the DSN built from DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME.
# DB_DSN=root:admin@tcp(127.0.0.1:3306)/api_stations_radio_link?parseTime=true&charset=utf8mb4&timeout=5s
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME=5m
DB_CONN_MAX_IDLE_TIME=5m
DB_PING_TIMEOUT=2s
